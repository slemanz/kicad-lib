(footprint "NetTie-2_SMD_Pad2.0mm"
	(version 20241229)
	(generator "pcbnew")
	(generator_version "9.0")
	(layer "F.Cu")
	(descr "Net tie, 2 pin, 2.0mm round SMD pads on 4mm pitch, joined by a 2.0mm wide copper bridge on F.Cu. Ties separate nets at a single point so DRC accepts the short. The bridge width is the current limit, roughly 3A at 10C rise on 1oz outer copper per IPC-2221. Pads carry no mask opening, the tie is never soldered. Cut both zones back so this footprint is the only copper path between them.")
	(tags "net tie")
	(property "Reference" "REF**"
		(at 0 -2 0)
		(layer "F.SilkS")
		(hide yes)
