(footprint "NetTie-3_SMD_Pad1.0mm"
	(version 20241229)
	(generator "pcbnew")
	(generator_version "9.0")
	(layer "F.Cu")
	(descr "Net tie, 3 pin, 1.0mm round SMD pads on 2mm pitch, joined by a 1.0mm wide copper bridge on F.Cu. Ties separate nets at a single point so DRC accepts the short. The bridge width is the current limit, roughly 1.8A at 10C rise on 1oz outer copper per IPC-2221. Pads carry no mask opening, the tie is never soldered. Cut both zones back so this footprint is the only copper path between them.")
	(tags "net tie")
	(property "Reference" "REF**"
		(at 0 -1.5 0)
		(layer "F.SilkS")
